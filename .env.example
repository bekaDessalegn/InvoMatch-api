# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call this API, or "*" for any (dev only).
CORS_ORIGIN=*

# --- Supabase ---
# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Service-role key (Project Settings > API). Server-only secret — grants full
# database access, bypassing Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
# Server-only secret. Used for invoice parsing and delivery-photo analysis.
# Never call Anthropic directly from the Flutter app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Platform admin ---
# Comma-separated emails that can open the super admin site. Use the same
# email you sign in with.
PLATFORM_ADMIN_EMAILS=

# Public URL of this API. Stripe sends the owner back here after checkout.
PUBLIC_BASE_URL=http://localhost:4000

# --- Stripe ---
# Leave blank until the products exist in Stripe. The app keeps working;
# checkout returns a clear error until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_SCAN_1=
STRIPE_PRICE_SCAN_5=
STRIPE_PRICE_SCAN_10=
