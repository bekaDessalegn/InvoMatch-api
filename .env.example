# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call this API, or "*" for any (dev only).
CORS_ORIGIN=*

# --- Supabase ---
# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Service-role key (Project Settings > API). Server-only secret — grants full
# database access, bypassing Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
# Server-only secret. Used for invoice parsing and delivery-photo analysis.
# Never call Anthropic directly from the Flutter app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
